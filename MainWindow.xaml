<Window x:Class="BlenderRenderHeadless.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Blender Render" Icon="Assets/blender-render-icon.png" Width="1050" Height="900" MinWidth="900" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#13161A" Foreground="White" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,13"><TextBlock Text="BLENDER RENDER" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Prepare cameras, queue jobs, and render without opening Blender." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <Border x:Name="DropZone" Grid.Row="1" Height="72" Background="#1B1F25" BorderBrush="#48515D" BorderThickness="1" CornerRadius="8" MouseLeftButtonUp="DropZone_Click" AllowDrop="True" PreviewDragEnter="DropZone_DragEnter" PreviewDragLeave="DropZone_DragLeave" PreviewDragOver="DropZone_DragOver" PreviewDrop="DropZone_Drop">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="DropTitleText" Text="Drop a .blend file here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="DropSubtitleText" Text="or click anywhere here to browse" Foreground="{StaticResource Muted}" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="880"/></StackPanel>
  </Border>
  <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,14,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CAMERAS AND PER-CAMERA OVERRIDES" FontSize="11" Foreground="#F57C23" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="StillsOnlyCheckBox" Content="STILLS ONLY · FRAME" Foreground="{StaticResource Muted}" Checked="FrameRangeMode_Changed" Unchecked="FrameRangeMode_Changed"/><TextBox x:Name="StillFrameText" Text="1" Width="46" Height="25" Margin="7,0,16,0" VerticalContentAlignment="Center" TextChanged="StillFrameText_Changed"/><CheckBox x:Name="KeyframeRangeCheckBox" Content="RANGE FROM KEYFRAMES" Foreground="{StaticResource Muted}" Checked="FrameRangeMode_Changed" Unchecked="FrameRangeMode_Changed"/></StackPanel><TextBlock x:Name="CameraCountText" Grid.Column="3" Text="Load a .blend file" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CameraItems"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#181C21" BorderBrush="#353C46" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="200" Height="112" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#090B0E" BorderBrush="#353C46" BorderThickness="1" CornerRadius="3">
       <Grid><TextBlock Text="Preview unavailable" Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" Foreground="White" FontWeight="SemiBold" FontSize="13"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CameraName}"/><TextBlock Text="  ACTIVE" Foreground="#F57C23" FontSize="10" Margin="7,2,0,0" Visibility="{Binding ActiveVisibility}"/><TextBlock Text="  PER-CAMERA RES" Foreground="#65C9FF" FontSize="10" Margin="7,2,0,0" Visibility="{Binding PerCameraResolutionVisibility}"/></StackPanel></CheckBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox Content="Overwrite" IsChecked="{Binding Overwrite}" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/><CheckBox Content="Placeholders" IsChecked="{Binding Placeholders}" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/><CheckBox Content="Ignore compositor" IsChecked="{Binding IgnoreCompositor}" Foreground="{StaticResource Muted}"/></StackPanel>
       </Grid>
       <Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="MODE" Style="{StaticResource FieldLabel}"/><ComboBox SelectedValue="{Binding RenderMode}" SelectedValuePath="Tag" Height="29"><ComboBoxItem Tag="FINAL" Content="Final render"/><ComboBoxItem Tag="PLAYBLAST" Content="Playblast"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="START" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StartFrame}" Height="29"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="END" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EndFrame}" Height="29"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="OUTPUT PATH" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Height="29"/></StackPanel><ComboBox Grid.Column="8" Width="112" Height="29" VerticalAlignment="Bottom" SelectedIndex="0" Tag="{Binding}" SelectionChanged="OutputToken_SelectionChanged"><ComboBoxItem Content="Add tokens…" IsEnabled="False"/><ComboBoxItem Content="Camera name" Tag="{}{camera_name}"/><ComboBoxItem Content="Blend name" Tag="{}{blend_name}"/></ComboBox><Button Grid.Column="10" Content="Browse…" Tag="{Binding}" Click="CameraOutputBrowse_Click" VerticalAlignment="Bottom" Height="29" Padding="10,5"/>
       </Grid>
       <Grid Grid.Row="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="ENGINE" Style="{StaticResource FieldLabel}"/><ComboBox SelectedValue="{Binding Engine}" SelectedValuePath="Tag" Height="29"><ComboBoxItem Tag="KEEP" Content="Saved setting"/><ComboBoxItem Tag="BLENDER_EEVEE" Content="EEVEE"/><ComboBoxItem Tag="CYCLES" Content="Cycles"/><ComboBoxItem Tag="BLENDER_WORKBENCH" Content="Workbench"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="WIDTH" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Width}" Height="29"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Height}" Height="29"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="SCALE %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Scale}" Height="29"/></StackPanel><StackPanel Grid.Column="8"><TextBlock Text="FRAME RATE" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FrameRate}" Height="29"/></StackPanel><StackPanel Grid.Column="10"><TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}"/><ComboBox SelectedValue="{Binding Format}" SelectedValuePath="Content" Height="29"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="OPEN_EXR"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="FFMPEG"/></ComboBox></StackPanel>
       </Grid>
      </Grid>
      </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid>
  </Border>
  <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="RENDER QUEUE" FontSize="11" Foreground="#F57C23" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ClearQueueButton" Grid.Column="1" Content="Clear completed" Click="ClearQueueButton_Click" Padding="10,5"/></Grid>
   <Grid Grid.Row="1" Margin="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="QueueItems"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="#181C21" BorderBrush="#303741" BorderThickness="0,0,0,1" Padding="10,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CameraName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding FrameSummary}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="{Binding ModeSummary}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="{Binding OutputPath}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/><Button Grid.Column="5" Content="Remove" Tag="{Binding}" Click="RemoveQueueItem_Click" Padding="9,4" IsEnabled="{Binding CanRemove, Mode=OneWay}"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,7,12,0" Foreground="#F57C23" Background="#2A3038"/><TextBlock Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Text="{Binding Estimate, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="EmptyQueueText" Text="No jobs queued. Tick cameras above, then choose Add selected to queue." Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  </Grid></Border>
  <Border Grid.Row="4" Background="#0D0F12" CornerRadius="8" Margin="0,14,0,14" Padding="12"><Grid><TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#ABB5C3" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="EmptyLogText" Text="Render messages will appear here." Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
  <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Waiting for a Blender file" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="BlenderButton" Grid.Column="1" Content="Set Blender…" Click="BlenderButton_Click"/><Button x:Name="AddQueueButton" Grid.Column="3" Content="Add selected to queue" Click="AddQueueButton_Click" IsEnabled="False"/><Button x:Name="RenderQueueButton" Grid.Column="5" Content="Render queue" Click="RenderQueueButton_Click" IsEnabled="False" Background="#F57C23" FontWeight="SemiBold"/></Grid>
 </Grid>
</Window>
