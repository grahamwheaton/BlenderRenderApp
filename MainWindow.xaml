<Window x:Class="BlenderRenderHeadless.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Blender Render" Icon="Assets/blender-render-icon.png" Width="1440" Height="860" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#11151A" Foreground="White" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="DropZone" Background="#151A20" BorderBrush="#2D343D" BorderThickness="0,0,0,1" MouseLeftButtonUp="DropZone_Click" AllowDrop="True" PreviewDragEnter="DropZone_DragEnter" PreviewDragLeave="DropZone_DragLeave" PreviewDragOver="DropZone_DragOver" PreviewDrop="DropZone_Drop">
   <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/blender-render-icon.png" Width="27" Height="27" Margin="0,0,10,0"/><TextBlock Text="Blender Render" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="V5.3.1" FontSize="9" Foreground="#F57C23" Margin="8,3,0,0" VerticalAlignment="Center"/></StackPanel>
    <Border Grid.Column="1" Background="#343B45" Margin="18,9"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><TextBlock x:Name="DropTitleText" Text="Choose or drop a .blend file" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="  ▾" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DropSubtitleText" Visibility="Collapsed"/></StackPanel>
    <Ellipse Grid.Column="3" Width="9" Height="9" Fill="#58B957"/><TextBlock Grid.Column="5" x:Name="StatusText" Text="Waiting for a Blender file" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="BlenderButton" Grid.Column="7" Content="Set Blender…" Click="BlenderButton_Click" Padding="9,5"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="385"/></Grid.ColumnDefinitions>
   <!-- LEFT: cameras -->
   <Grid Background="#171C22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="CAMERAS" FontSize="12" FontWeight="SemiBold" Margin="18,18,18,12"/>
    <TextBlock x:Name="CameraCountText" Grid.Row="1" Text="No file" Foreground="#F57C23" FontSize="10" HorizontalAlignment="Right" Margin="18,0,18,12"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,8,0"><ItemsControl x:Name="CameraItems"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#1C2229" BorderBrush="{Binding FocusBorderBrush}" BorderThickness="2" CornerRadius="7" Padding="9" Margin="0,0,6,9" Tag="{Binding}" MouseLeftButtonUp="CameraCard_Click" Cursor="Hand"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="78"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,8,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="◉" Foreground="{StaticResource Muted}" Margin="0,0,7,0"/><TextBlock Text="{Binding CameraName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="#29313A" CornerRadius="3" Padding="5,3" Margin="4,0"><TextBlock Text="{Binding ResolutionSummary}" FontSize="9"/></Border><Border Grid.Column="3" Background="#29313A" CornerRadius="3" Padding="5,3"><TextBlock Text="{Binding FrameRateSummary}" FontSize="9"/></Border></Grid>
      <Grid Grid.Row="1" Margin="27,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><Border Background="#090C10"><Grid><TextBlock Text="No preview" Foreground="#68717D" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" Margin="11,3"><TextBlock Text="{Binding ModeSummary}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding EngineSummary}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0"/><TextBlock Text="PER-CAMERA" Foreground="#65C9FF" FontSize="8" Margin="0,8,0,0" Visibility="{Binding PerCameraResolutionVisibility}"/></StackPanel><StackPanel Grid.Column="2"><Button Content="COPY" Tag="{Binding}" Click="CopyCamera_Click" Padding="5,4" FontSize="9" Background="#F57C23" Margin="0,0,0,6"/><Button Content="PASTE" Tag="{Binding}" Click="PasteCamera_Click" Padding="5,4" FontSize="9" Background="#F57C23"/></StackPanel></Grid>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Grid Grid.Row="3" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Select all" Click="SelectAll_Click"/><Button Grid.Column="2" Content="Clear selection" Click="ClearSelection_Click"/></Grid>
   </Grid>
   <Border Grid.Column="1" Background="#303740"/>
   <!-- CENTRE: focused camera -->
   <Grid Grid.Column="2" Background="#151A20" Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="EditorHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{StaticResource Muted}" FontSize="19" Margin="0,0,9,0"/><TextBlock Text="{Binding CameraName}" FontSize="18" FontWeight="SemiBold"/><Border Background="#263441" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" Visibility="{Binding PerCameraResolutionVisibility}"><TextBlock Text="PER-CAMERA" Foreground="#65C9FF" FontSize="10"/></Border><Border x:Name="QueueReviewBadge" Background="#3A302A" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" Visibility="Collapsed"><TextBlock Text="QUEUE REVIEW" Foreground="#F57C23" FontSize="10"/></Border></StackPanel><Button Grid.Column="1" Content="Browse .blend…" Click="ChooseBlendButton_Click" Padding="10,5"/></Grid>
    <Border Grid.Row="1" Margin="0,16" Background="#090C10" BorderBrush="#303842" BorderThickness="1" CornerRadius="6"><Grid><TextBlock Text="Select a camera to edit" Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/></Grid></Border>
    <ScrollViewer x:Name="CameraSettingsEditor" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CameraSettingsContent">
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="FinalRenderButton" Content="FINAL RENDER" Tag="FINAL" Click="SetRenderMode_Click" Height="38"/><Button x:Name="PlayblastButton" Grid.Column="2" Content="PLAYBLAST" Tag="PLAYBLAST" Click="SetRenderMode_Click" Height="38"/></Grid>
     <Border Background="#1B2128" BorderBrush="#343C46" BorderThickness="1" CornerRadius="7" Padding="18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,20,0">
        <TextBlock Text="FRAME RANGE" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="START" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StartFrame, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="END" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EndFrame, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="STEP" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FrameStep, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Grid.Column="6"><TextBlock Text="FRAME RATE" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FrameRate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </Grid>
        <CheckBox x:Name="KeyframeRangeCheckBox" Content="Range from camera keyframes" Foreground="{StaticResource Muted}" Margin="0,12,0,0" Checked="FrameRangeMode_Changed" Unchecked="FrameRangeMode_Changed"/>
        <Border Height="1" Background="#343C46" Margin="0,24,0,20"/>
        <TextBlock Text="RENDER ENGINE" Style="{StaticResource SectionTitle}"/>
        <ComboBox SelectedValue="{Binding Engine}" SelectedValuePath="Tag" Height="36"><ComboBoxItem Tag="KEEP" Content="Saved setting"/><ComboBoxItem Tag="BLENDER_EEVEE" Content="EEVEE"/><ComboBoxItem Tag="CYCLES" Content="Cycles"/><ComboBoxItem Tag="BLENDER_WORKBENCH" Content="Workbench"/></ComboBox>
        <CheckBox Content="Transparent background" IsChecked="{Binding TransparentBackground}" Margin="0,14,0,0"/>
       </StackPanel>
       <Border Grid.Column="1" Background="#343C46"/>
       <StackPanel Grid.Column="2" Margin="20,0,0,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}"/><TextBlock Text="COMPOSITOR FILE OUTPUT" Foreground="#65C9FF" FontSize="9" Margin="10,1,0,0" Visibility="{Binding CompositorOutputVisibility}"/></StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Height="36" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="Browse…" Tag="{Binding}" Click="CameraOutputBrowse_Click" Padding="12,5"/></Grid>
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Height="36" SelectedIndex="0" Tag="{Binding}" SelectionChanged="OutputToken_SelectionChanged"><ComboBoxItem Content="Add tokens…" IsEnabled="False"/><ComboBoxItem Content="Camera name" Tag="{}{camera_name}"/><ComboBoxItem Content="Blend name" Tag="{}{blend_name}"/></ComboBox><Button Grid.Column="2" Content="COPY TO SELECTION" Tag="{Binding}" Click="CopyOutputToSelection_Click" Padding="12,5" FontSize="9"/></Grid>
        <Border Height="1" Background="#343C46" Margin="0,24,0,20"/>
        <TextBlock Text="RESOLUTION" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WIDTH" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="SCALE %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
        <Border Height="1" Background="#343C46" Margin="0,24,0,20"/>
        <TextBlock Text="FORMAT" Style="{StaticResource SectionTitle}"/>
        <ComboBox SelectedValue="{Binding Format}" SelectedValuePath="Content" Height="36"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="OPEN_EXR"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="FFMPEG"/></ComboBox>
       </StackPanel>
      </Grid>
     </Border>
     <Expander Header="ADVANCED OPTIONS" Margin="0,14,0,0" Background="#1B2128" BorderBrush="#343C46" BorderThickness="1" Padding="15"><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><CheckBox Content="Overwrite" IsChecked="{Binding Overwrite}" Margin="0,0,22,0"/><CheckBox Content="Placeholders" IsChecked="{Binding Placeholders}" Margin="0,0,22,0"/><CheckBox Content="Ignore compositor" IsChecked="{Binding IgnoreCompositor}"/></StackPanel></Expander>
     <Expander Header="RENDER LOG" Margin="0,10,0,0" Background="#101419" BorderBrush="#343C46" BorderThickness="1" Padding="12"><Grid Height="100"><TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#ABB5C3" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="EmptyLogText" Text="Render messages will appear here." Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Expander>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Column="3" Background="#303740"/>
   <!-- RIGHT: queue -->
   <Grid Grid.Column="4" Background="#171C22" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="RENDER QUEUE" FontSize="12" FontWeight="SemiBold"/><Button x:Name="ClearCompletedButton" Grid.Column="1" Content="Clear completed" Click="ClearCompletedButton_Click" Padding="10,6"/><Button x:Name="ClearQueueButton" Grid.Column="3" Content="Clear queue" Click="ClearQueueButton_Click" Padding="10,6"/></Grid>
    <Grid Grid.Row="1" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="9"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="9"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="QueueCountText" Text="0 jobs" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WatchCountdownText" Foreground="#F57C23" FontSize="10" Margin="0,4,0,0" Visibility="Collapsed"/></StackPanel><CheckBox x:Name="WatchModeCheckBox" Grid.Column="1" Content="Watch" VerticalAlignment="Center" Checked="WatchMode_Changed" Unchecked="WatchMode_Changed"/><CheckBox x:Name="OnlyMyPcCheckBox" Grid.Column="3" Content="ONLY MY PC" ToolTip="Only accept jobs sent from this computer" VerticalAlignment="Center" Checked="OnlyMyPc_Changed" Unchecked="OnlyMyPc_Changed"/><CheckBox x:Name="AutoStartCheckBox" Grid.Column="5" Content="Auto start" VerticalAlignment="Center" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/><Button x:Name="WatchFolderButton" Grid.Column="7" Click="WatchFolderButton_Click" Padding="8,5" ToolTip="Choose NAS render queue folder"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;"/></Button></Grid>
    <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="QueueItems"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1C2229" BorderBrush="#353E48" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Height="76" Background="#090C10"><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="12,2"><TextBlock Text="{Binding CameraName}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding FrameSummary}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock Text="{Binding SettingsSummary}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold"/><Button Content="×" Tag="{Binding}" Click="RemoveQueueItem_Click" Padding="7,2" Margin="0,10,0,0" IsEnabled="{Binding CanRemove, Mode=OneWay}"/><Button Tag="{Binding}" Click="OpenOutputFolder_Click" Padding="7,4" Margin="0,6,0,0" ToolTip="Open output folder"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="13"/></Button></StackPanel></Grid><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Estimate}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="{StaticResource Muted}" FontSize="10"/></Grid><ProgressBar Grid.Row="2" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,7,0,0" Foreground="#F57C23" Background="#343B45"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="EmptyQueueText" Text="No jobs queued" Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <Button x:Name="RenderQueueButton" Grid.Row="3" Content="▶  Render queue" Click="RenderQueueButton_Click" IsEnabled="False" Height="48" Background="#F57C23" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,10"/>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AddQueueButton" Content="＋ Add selected" Click="AddQueueButton_Click" IsEnabled="False"/><Button x:Name="ContactSheetButton" Grid.Column="2" Content="▣ Contact sheet…" Click="ContactSheetButton_Click" IsEnabled="False"/></Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
