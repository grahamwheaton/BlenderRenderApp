        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Height="28" SelectedIndex="0" Tag="{Binding}" SelectionChanged="OutputToken_SelectionChanged"><ComboBoxItem Content="Add tokens…" IsEnabled="False"/><ComboBoxItem Content="Camera name" Tag="{}{camera_name}"/><ComboBoxItem Content="Blend name" Tag="{}{blend_name}"/></ComboBox><Button Grid.Column="2" Content="COPY OUTPUT" Tag="{Binding}" Click="CopyOutputToSelection_Click" Padding="4,5" FontSize="9"/></Grid>
        <Border Height="1" Background="#343C46" Margin="0,8"/>
        <TextBlock Text="RESOLUTION" Style="{StaticResource SectionTitle}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WIDTH" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="SCALE %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
        <Border Height="1" Background="#343C46" Margin="0,8"/>
        <TextBlock Text="FORMAT" Style="{StaticResource SectionTitle}"/>
        <ComboBox SelectedValue="{Binding Format}" SelectedValuePath="Content" Height="28"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="OPEN_EXR"/><ComboBoxItem Content="OPEN_EXR_MULTILAYER"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="FFMPEG"/></ComboBox>
       </StackPanel>
      </Grid>
     </Border>
     <Expander Header="ADVANCED OPTIONS" IsExpanded="True" Margin="0,6,0,0" Background="#1B2128" BorderBrush="#343C46" BorderThickness="1" Padding="8"><WrapPanel Margin="0,6,0,0"><CheckBox Content="Overwrite" IsChecked="{Binding Overwrite}" Margin="0,0,22,8"/><CheckBox Content="Placeholders" IsChecked="{Binding Placeholders}" Margin="0,0,22,8"/><CheckBox Content="Ignore compositor" IsChecked="{Binding IgnoreCompositor}" Margin="0,0,22,8"/><CheckBox Content="Viewport overlays" IsChecked="{Binding ShowOverlays}" ToolTip="Include viewport overlays in Playblast jobs" Margin="0,0,22,8"/></WrapPanel></Expander>
     </StackPanel><Expander Header="RENDER LOG" Margin="0,10,0,0" Background="#101419" BorderBrush="#343C46" BorderThickness="1" Padding="8"><Grid Height="100"><TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#ABB5C3" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="EmptyLogText" Text="Render messages will appear here." Foreground="#68717D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Expander>
    </StackPanel></ScrollViewer>
<Expander Grid.Row="3" Header="Loaded camera tools / contact sheet" Background="#171C22" Margin="0,10,0,0"><StackPanel MaxHeight="340">
<TextBlock x:Name="CameraCountText" Text="No file loaded"/>
<ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CameraItems"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="6" Tag="{Binding}" MouseLeftButtonUp="CameraCard_Click"><DockPanel><CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Paste" Tag="{Binding}" Click="PasteCamera_Click"/><Button DockPanel.Dock="Right" Content="Copy" Tag="{Binding}" Click="CopyCamera_Click"/><Image Source="{Binding ThumbnailPath, Converter={StaticResource PreviewImage}}" Width="64" Height="28" Stretch="Uniform" Margin="6,0"/><TextBlock Text="{Binding CameraName}" VerticalAlignment="Center" Margin="8,0"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<WrapPanel><Button Content="Select all" Click="SelectAll_Click"/><Button Content="Clear selection" Click="ClearSelection_Click"/></WrapPanel>
<WrapPanel><Button x:Name="AddQueueButton" Content="＋ Add selected copies" Click="AddQueueButton_Click" IsEnabled="False"/><Button x:Name="ContactSheetButton" Content="Contact sheet…" Click="ContactSheetButton_Click" IsEnabled="False" Margin="8,0,0,0"/></WrapPanel></StackPanel></Expander>
</Grid></Grid></Grid></Window>
