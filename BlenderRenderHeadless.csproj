<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Blender Render Launcher</AssemblyName>
    <Version>8.1.1</Version>
    <FileVersion>8.1.1.0</FileVersion>
    <AssemblyVersion>8.1.1.0</AssemblyVersion>
    <ApplicationIcon>Assets\blender-render-icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Vendor\FFmpeg\ffmpeg.exe" LogicalName="BlenderRenderHeadless.FFmpeg.ffmpeg.exe" />
    <EmbeddedResource Include="Vendor\FFmpeg\LICENSE" LogicalName="BlenderRenderHeadless.FFmpeg.LICENSE" />
    <EmbeddedResource Include="Vendor\FFmpeg\README.txt" LogicalName="BlenderRenderHeadless.FFmpeg.README.txt" />
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Include="Scripts\*.py" LogicalName="BlenderRenderHeadless.Scripts.%(Filename)%(Extension)" />
    <None Remove="Assets\blender-render-icon.png" />
    <Resource Include="Assets\blender-render-icon.png" />
    <None Include="Assets\blender-render-icon.ico" />
  </ItemGroup>
  <Target Name="RequireBundledFfmpeg" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Vendor\FFmpeg\ffmpeg.exe')" Text="Stage FFmpeg in Vendor\FFmpeg before building. See Vendor\FFmpeg\README.txt for the exact build." />
  </Target>
</Project>
